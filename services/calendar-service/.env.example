PORT=3002

DATABASE_URL=postgres://calendar_service:calendar_service@localhost:5432/calendar_db

NATS_URL=nats://localhost:4222

# Vérification JWT locale en filet de sécurité (défense en profondeur) —
# valeur PEM directe (K8s Secret) ou chemin de fichier (dev local).
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=../auth-service/keys/jwt-public.pem

# Paire interne calendar-service → auth-service (résolution d'email pour CalDAV)
AUTH_SERVICE_INTERNAL_URL=http://localhost:3001
INTERNAL_SECRET_CALENDAR_AUTH=CHANGE_ME

# Paire interne tracking-service → calendar-service (création d'un événement
# calendrier depuis un suivi tuteur)
INTERNAL_SECRET_TRACKING_CALENDAR=CHANGE_ME
