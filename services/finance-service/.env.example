PORT=3003

DATABASE_URL=postgres://finance_service:finance_service@localhost:5432/finance_db

# Vérification JWT locale en filet de sécurité (défense en profondeur) —
# valeur PEM directe (K8s Secret) ou chemin de fichier (dev local).
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=../auth-service/keys/jwt-public.pem

# API Légifrance (PISTE) — https://piste.gouv.fr, OAuth2 client-credentials.
# Base KALI (conventions collectives). Sandbox pour le dev.
LEGIFRANCE_OAUTH_URL=https://sandbox-oauth.piste.gouv.fr/api/oauth/token
LEGIFRANCE_API_BASE_URL=https://sandbox-api.piste.gouv.fr/dila/legifrance/lf-engine-app
LEGIFRANCE_CLIENT_ID=CHANGE_ME
LEGIFRANCE_CLIENT_SECRET=CHANGE_ME

# API Entreprise (entreprise.api.gouv.fr) — convention collective par SIRET.
ENTREPRISE_API_BASE_URL=https://staging.entreprise.api.gouv.fr
ENTREPRISE_API_TOKEN=CHANGE_ME
