PORT=3003

DATABASE_URL=postgres://finance_service:finance_service@localhost:5432/finance_db

# Vérification JWT locale en filet de sécurité (défense en profondeur) —
# valeur PEM directe (K8s Secret) ou chemin de fichier (dev local).
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=../auth-service/keys/jwt-public.pem

# API Légifrance (PISTE) — https://piste.gouv.fr, OAuth2 client-credentials.
# Base KALI (conventions collectives). Créer une application sur PISTE,
# souscrire à l'API "Légifrance", générer des identifiants OAuth (pas juste
# une API Key) dans l'onglet Authentification de l'application.
LEGIFRANCE_OAUTH_URL=https://oauth.piste.gouv.fr/api/oauth/token
LEGIFRANCE_API_BASE_URL=https://api.piste.gouv.fr/dila/legifrance/lf-engine-app
LEGIFRANCE_CLIENT_ID=CHANGE_ME
LEGIFRANCE_CLIENT_SECRET=CHANGE_ME

# siret2idcc (SocialGouv) — convention collective par SIRET, gratuit, sans
# authentification. Remplace l'API Entreprise (entreprise.api.gouv.fr,
# nécessite ProConnect, réservé aux organismes habilités — inaccessible pour
# un projet en phase de dev, décision du 2026-09-19).
SIRET2IDCC_BASE_URL=https://siret2idcc.fabrique.social.gouv.fr/api/v2
