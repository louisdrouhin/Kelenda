PORT=3003

DATABASE_URL=postgres://tracking_service:tracking_service@localhost:5432/tracking_db

NATS_URL=nats://localhost:4222

# Vérification JWT locale en filet de sécurité (défense en profondeur) —
# valeur PEM directe (K8s Secret) ou chemin de fichier (dev local).
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=../auth-service/keys/jwt-public.pem

# Paire interne tracking-service → calendar-service (création d'un événement
# calendrier depuis un suivi tuteur)
CALENDAR_SERVICE_INTERNAL_URL=http://localhost:3002
INTERNAL_SECRET_TRACKING_CALENDAR=CHANGE_ME

# Paire interne tracking-service → notification-service (email de confirmation à un tuteur)
NOTIFICATION_SERVICE_INTERNAL_URL=http://localhost:3004
INTERNAL_SECRET_TRACKING_NOTIFICATION=CHANGE_ME
