PORT=3004

DATABASE_URL=postgres://notification_service:notification_service@localhost:5432/notification_db

NATS_URL=nats://localhost:4222

# Vérification JWT locale en filet de sécurité (défense en profondeur) —
# valeur PEM directe (K8s Secret) ou chemin de fichier (dev local).
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=../auth-service/keys/jwt-public.pem

# Paire interne notification-service → auth-service (résolution d'email pour le canal email)
AUTH_SERVICE_INTERNAL_URL=http://localhost:3001
INTERNAL_SECRET_NOTIFICATION_AUTH=CHANGE_ME

# Paire interne tracking-service → notification-service (email de confirmation à un tuteur)
INTERNAL_SECRET_TRACKING_NOTIFICATION=CHANGE_ME

# Web push (VAPID) — générer une paire de clés avec `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# SMTP générique (ex. Infomaniak : mail.infomaniak.com, port 587 STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
