PORT=3001

DATABASE_URL=postgres://auth_service:auth_service@localhost:5432/auth_db

NATS_URL=nats://localhost:4222

JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

OAUTH_REDIRECT_BASE_URL=http://localhost:3001
# openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=CHANGE_ME

# Après un login OAuth réussi, /auth/callback/:provider redirige vers
# ${FRONTEND_URL}/oauth/callback?code=... (code d'échange à usage unique,
# voir POST /auth/exchange)
FRONTEND_URL=http://localhost:5183

GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME

MICROSOFT_OAUTH_CLIENT_ID=CHANGE_ME
MICROSOFT_OAUTH_CLIENT_SECRET=CHANGE_ME

GITHUB_OAUTH_CLIENT_ID=CHANGE_ME
GITHUB_OAUTH_CLIENT_SECRET=CHANGE_ME

# Secrets HMAC par paire d'appelant interne (openssl rand -hex 32 chacun)
INTERNAL_SECRET_TRACKING_AUTH=CHANGE_ME
INTERNAL_SECRET_NOTIFICATION_AUTH=CHANGE_ME
INTERNAL_SECRET_CALENDAR_AUTH=CHANGE_ME
